{
  "name": "@schmack/playbooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && node scripts/build.mjs",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
