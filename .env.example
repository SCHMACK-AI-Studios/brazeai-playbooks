# Server-only settings. Use the same Supabase project as SCHMACK-website.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random secret of at least 32 bytes. Only the playbook server needs this.
PLAYBOOK_SESSION_SECRET=
PUBLIC_ORIGIN=https://playbooks.schmack.com
WEBSITE_ORIGIN=https://schmack.com
PORT=5195
# Build-time link back to the website (defaults to the production Resources folder).
VITE_RESOURCES_URL=https://schmack.com/?folder=resources
# For local gated-server testing only: NODE_ENV=development and localhost origins.
